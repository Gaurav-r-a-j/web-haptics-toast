{
  "name": "web-haptics-toast",
  "version": "1.0.3",
  "description": "Standalone React toasts with built-in haptics and a Sonner-compatible API. Single dependency—no separate haptics package.",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./dist/styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bunchee --watch",
    "build": "bunchee && cp src/styles.css dist/styles.css",
    "type-check": "tsc --noEmit",
    "dev:website": "turbo run dev --filter=website...",
    "dev:test": "turbo run dev --filter=test...",
    "format": "prettier --write .",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "keywords": [
    "react",
    "notifications",
    "toast",
    "snackbar",
    "message",
    "haptics",
    "vibration",
    "web-haptics"
  ],
  "author": "DesignByte <https://studio.designbyte.dev>",
  "license": "MIT",
  "homepage": "https://web-haptics-toast.designbyte.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaurav-r-a-j/web-haptics-toast.git"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@babel/core@<=7.29.0": ">=7.29.6 <8",
      "@hono/node-server@<1.19.13": ">=1.19.13 <2",
      "@humanfs/node@<0.16.8": ">=0.16.8 <0.17",
      "@xmldom/xmldom@<0.9.9": ">=0.9.9 <0.10",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": ">=2.11.0 <3",
      "browserslist@<=4.28.6": ">=4.28.7 <5",
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6 <6",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0 <3",
      "dompurify@<3.4.0": ">=3.4.0 <4",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4 <4",
      "hono@<4.12.12": ">=4.12.12 <5",
      "ip-address@<=10.1.0": ">=10.1.1 <11",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0 <5",
      "jsondiffpatch@<0.7.6": ">=0.7.6 <0.8",
      "mermaid@>=11.0.0-alpha.1 <=11.14.0": ">=11.15.0 <12",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.10": ">=8.5.10 <9",
      "postcss-selector-parser@>=7.1.0 <7.1.3": ">=7.1.3 <8",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2 <7",
      "sharp@<0.35.0": ">=0.35.0 <0.36",
      "svelte@>=5.46.0 <=5.55.6": ">=5.55.7 <6",
      "uuid@<11.1.1": ">=11.1.1 <12"
    }
  },
  "bugs": {
    "url": "https://github.com/Gaurav-r-a-j/web-haptics-toast/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.49.1",
    "@types/node": "^18.11.13",
    "@types/react": "19.2.14",
    "bunchee": "6.3.3",
    "prettier": "^2.8.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "turbo": "^2.9.14",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0 || ^19.0.0-rc",
    "react-dom": "^18.0.0 || ^19.0.0 || ^19.0.0-rc"
  },
  "packageManager": "pnpm@9.15.9"
}
